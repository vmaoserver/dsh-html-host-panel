{
  "name": "dsh-html-host-panel",
  "version": "1.1.0",
  "type": "module",
  "description": "Browse HTML pages hosted on pages.vmao.top from a left sidebar panel in DeepSeek Harness; new pages are published through the html_host_publish agent tool.",
  "license": "MIT",
  "author": "",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "html",
    "hosting",
    "pages",
    "html-host"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
